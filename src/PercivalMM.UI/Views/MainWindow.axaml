<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PercivalMM.UI.ViewModels"
        xmlns:models="using:PercivalMM.Core.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        x:Class="PercivalMM.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Percival Mod Manager (PercivalMM)"
        Width="950" Height="680"
        Background="#1e1e24">

        <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        
        <!-- HEADER LAYER SECTION -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Title & Tagline -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,14">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Viewbox Width="54" Height="54" VerticalAlignment="Center">
    <Canvas Width="512" Height="512">
        <!-- Layer 1: White Sticker Outline -->
        <Path Fill="#FFFFFF" Data="M424.316 72.717 C433.663 77.081 438.152 88.185 434.643 97.86 L432.767 103.032 L427.267 103.131 C426.57 103.144 425.628 103.136 425.049 103.158 C424.933 103.163 424.641 103.176 424.465 103.203 C424.29 103.344 424.137 103.536 424.004 103.716 C423.26 104.724 422.611 106.34 422.113 107.982 C421.444 110.188 420.952 112.715 420.564 115.177 C420.128 117.939 419.806 120.705 419.492 123.215 C419.131 126.11 418.791 128.601 418.316 130.73 C415.531 143.204 412.101 155.394 405.903 166.693 C403.699 170.71 401.486 174.742 398.797 178.47 C397.613 180.113 396.438 181.499 395.157 183.096 C394.656 183.72 394.126 184.395 393.641 185.074 C394.347 190.146 392.548 196.466 389.356 200.43 C386.175 204.381 382.151 207.223 376.941 207.55 C375.822 208.942 374.8 210.396 373.6 211.726 C371.029 214.573 368.121 217.003 365.332 219.617 L360.589 224.06 C371.79 239.233 377.286 258.441 374.825 277.536 C373.782 285.632 371.519 292.836 368.235 299.567 C365.954 304.242 363.194 308.665 360.007 313.031 C362.261 315.968 364.37 318.966 366.274 322.279 C374.045 335.808 377.056 352.721 374.731 368.118 C373.859 373.889 372.233 379.252 370.318 384.74 C367.416 393.054 362.283 400.665 356.529 407.243 C356.228 407.587 355.679 408.263 355.138 408.899 C353.135 411.256 350.827 413.702 347.863 414.812 C348.628 415.181 349.39 415.56 350.149 415.947 C362.748 422.38 376.935 435.504 375.104 451.009 C374.448 456.564 371.739 462.019 366.581 466.952 C363.085 470.296 358.838 472.574 354.517 474.657 C350.391 476.646 346.196 477.928 341.838 479.232 C326.002 483.97 309.597 485.583 293.216 487.184 C287.689 487.724 282.079 487.907 276.602 488.847 C272.285 489.588 267.884 490.844 264.378 493.576 C263.918 493.934 263.487 494.433 263.097 494.866 C262.528 495.497 261.972 496.135 261.41 496.729 L255.73 502.729 L249.916 496.859 C247.686 494.608 245.181 492.256 242.279 490.902 C241.117 490.359 239.883 489.958 238.434 489.618 C236.737 489.221 234.813 488.924 232.524 488.652 C224.343 487.681 216.017 487.00