4 401.458 297.052 399.72 294.337 397.436 C292.169 395.612 285.341 388.78 285.033 386.099 C284.754 383.669 285.576 381.73 286.279 379.479 C287.058 376.986 287.644 374.278 288.714 371.896 C291.551 365.575 295.983 360.671 294.403 353.323 C294.009 351.488 293.231 349.419 292.001 347.966 C291.666 347.569 291.251 347.148 290.734 347.014 C288.218 346.363 280.461 346.925 277.407 346.925 Z"/>
        <!-- Layer 3: Mint Monogram (#87CF3E) -->
        <Path Fill="#87CF3E" Data="M99.139 211.853 C99.139 199.665 99.266 187.254 102.78 175.469 C104.268 178.197 106.028 180.714 107.81 183.256 C108.646 184.448 109.838 185.74 110.361 187.104 C110.899 188.504 110.552 190.225 110.81 191.693 C111.686 196.688 113.872 202.053 117.626 205.596 C119.907 207.749 122.32 209.833 125.256 211.061 C126.752 211.687 128.59 211.819 129.959 212.708 C132.814 214.561 134.95 217.83 137.509 220.08 C138.778 221.195 143.541 224.487 143.828 225.917 C144.417 228.848 143.924 232.369 143.924 235.358 L143.924 257.227 C143.924 279.221 143.889 301.213 143.889 323.207 C143.889 329.812 143.44 336.649 144.547 343.191 C147.278 359.317 159.246 373.013 174.736 378.129 C185.875 381.808 202.035 380.083 213.937 380.335 L210.395 385.122 C208.755 384.48 207.024 383.601 205.293 383.23 C194.927 381.01 184.344 385.996 178.606 394.744 C176.642 397.739 175.53 401.03 174.407 404.396 C168.658 406.475 162.893 408.649 157.584 411.71 C156.251 412.479 151.407 415.854 150.195 415.765 C147.774 415.587 142.466 411.668 140.19 410.32 C128.819 403.586 118.952 392.466 112.193 381.244 C105.83 370.68 101.513 358.641 100.04 346.36 C98.713 335.298 99.313 323.955 99.313 312.839 C99.313 287.097 99.854 261.29 99.309 235.554 C99.141 227.661 99.139 219.757 99.139 211.853 Z M271.338 201.38 L188.762 201.38 L188.762 245.955 L262.906 245.955 C275.305 245.955 287.771 245.576 300.163 245.965 C312.429 246.351 323.041 255.765 322.894 268.494 C322.748 281.029 312.347 290.455 300.141 290.823 C288.487 291.175 276.77 290.823 265.109 290.831 C239.66 290.847 214.211 290.832 188.762 290.832 L188.762 335.407 L269.321 335.407 L291.935 335.407 C296.611 335.407 301.985 334.794 306.485 336.324 C323.845 342.226 328.821 362.871 314.62 375.164 C309.517 379.582 303.017 380.211 296.578 380.325 L300.273 384.986 C301.983 384.377 303.79 383.49 305.581 383.159 C317.425 380.973 328.705 387.591 333.861 398.256 C334.784 400.166 335.313 402.339 336.015 404.338 C337.323 404.827 343.779 407.618 344.796 407.398 C346.537 407.023 349.315 403.339 350.508 401.975 C355.565 396.195 360.213 389.416 362.765 382.104 C364.505 377.118 366.029 372.164 366.821 366.923 C368.876 353.313 366.208 338.226 359.337 326.264 C356.608 321.515 353.295 317.348 349.853 313.113 C358.846 301.968 365.027 290.979 366.891 276.514 C370.095 251.642 358.073 226.486 337.266 212.728 C333.615 210.314 329.678 207.935 325.55 206.409 C320.276 204.459 314.898 202.816 309.311 202.037 C303.695 201.254 297.937 201.38 292.283 201.38 Z"/>
    </Canvas>
</Viewbox>

                    <TextBlock Text="PERCIVAL MOD MANAGER" FontSize="26" FontWeight="Bold" Foreground="#f5f5f6" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Guiding your Linux Mint game configurations straight to their Holy Grails" FontSize="12" Foreground="#8a8a93" Margin="0,5,0,0"/>
            </StackPanel>




            <!-- Top-Right Flush Banner: touches top-right window corner & grey divider line -->
            <Image Grid.Column="1"
                   Source="{Binding ActiveGameBanner}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Stretch"
                   Stretch="UniformToFill"
                   Margin="0,-20,-20,1">
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="Transparent" Offset="0.0"/>
                        <GradientStop Color="Black" Offset="0.25"/>
                        <GradientStop Color="Black" Offset="1.0"/>
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>

            <!-- Bottom Header Divider Line -->
            <Separator Grid.ColumnSpan="2" VerticalAlignment="Bottom" Background="#2a2a35" Height="1" Margin="0,0,-20,0"/>
        </Grid>

 

         


        <!-- MAIN ACTIVE WORKSPACE INTERFACE -->
        <Grid Grid.Row="1" ColumnDefinitions="240, *">
            
            <!-- LEFT CONTROL LOG PANEL SIDEBAR -->
            <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,20,0">
                <TextBlock Text="Active Game Module" FontWeight="Bold" Foreground="#a1a1aa"/>
                <ComboBox ItemsSource="{Binding AvailableGames}"
                          SelectedItem="{Binding SelectedGame}"
                          HorizontalAlignment="Stretch"
                          Background="#2a2a35"
                          Foreground="#38bdf8"
                          FontWeight="SemiBold"
                          Padding="10,8">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding GameName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>


                <Button Content="🔍 Rescan Target Drive" 
                        Command="{Binding TriggerSSDScanCommand}"
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"
                        Background="#0284c7" Foreground="White" Padding="10,8" Margin="0,15,0,0"/>
                
                <Button Content="📦 Import Mod Archive (.zip/.rar/.7z)" 
                        Click="OnImportModClicked"
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"
                        Background="#22c55e" Foreground="White" Padding="10,8"/>

                <Separator Background="#2a2a35" Height="1" Margin="0,10,0,10"/>

                        <Button Content="{Binding LaunchButtonText}" 
                        Command="{Binding LaunchGameCommand}"
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"
                        FontWeight="Bold"
                        Background="#E54E00" Foreground="White" Padding="12,10"/>

            </StackPanel>

            <!-- RIGHT SYSTEM RADAR & INSTALLED MOD GRID VIEWER -->
            <Border Grid.Column="1" Background="#111115" CornerRadius="8" Padding="20">
                <Grid RowDefinitions="Auto, Auto, *, Auto, 130">
                    
                    <TextBlock Grid.Row="0" Text="📡 Core Storage Detection Radar &amp; Mod Load Order" FontSize="16" FontWeight="SemiBold" Foreground="#f5f5f6" Margin="0,0,0,10"/> 
                    
                    <Border Grid.Row="1" Background="#1a1a22" BorderBrush="#2a2a35" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Detected Target Path Layout:" FontSize="11" Foreground="#71717a"/>
                            <TextBlock Text="{Binding DiscoveredGamePathText}" FontSize="13" FontWeight="Medium" Foreground="#a7f3d0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                                        <!-- INSTALLED MOD GRID TABLE -->
                    <Border Grid.Row="2" Background="#09090b" BorderBrush="#2a2a35" BorderThickness="1" CornerRadius="6" Padding="8">
                        <Grid RowDefinitions="Auto, *">
                            <!-- Table Column Headers -->
                            <Grid Grid.Row="0" ColumnDefinitions="65, 60, *, 90, 45" Margin="8,4,8,8">
                                <TextBlock Grid.Column="0" Text="Active" FontSize="12" FontWeight="Bold" Foreground="#71717a"/>
                                <TextBlock Grid.Column="1" Text="Rank" FontSize="12" FontWeight="Bold" Foreground="#71717a"/>
                                <TextBlock Grid.Column="2" Text="Installed Mod Bundle" FontSize="12" FontWeight="Bold" Foreground="#71717a"/>
                                <TextBlock Grid.Column="3" Text="Priority" FontSize="12" FontWeight="Bold" Foreground="#71717a" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Del" FontSize="12" FontWeight="Bold" Foreground="#71717a" HorizontalAlignment="Center"/>
                            </Grid>

                            <!-- Scrollable Rows -->
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding InstalledMods}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:InstalledModItem">
                                            <Border Background="#18181f" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="65, 60, *, 90, 45">
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsEnabled}"
                                                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleModCommand}"
                                                              CommandParameter="{Binding}"
                                                              VerticalAlignment="Center"/>
                                                    
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Priority, StringFormat='#{0}'}"
                                                               Foreground="#38bdf8"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Name}"
                                                               Foreground="#f5f5f6"
                                                               FontWeight="Medium"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                        <Button Content="▲"
                                                                Padding="6,2"
                                                                FontSize="10"
                                                                Background="#2a2a35"
                                                                Foreground="#e4e4e7"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MoveModUpCommand}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="▼"
                                                                Padding="6,2"
                                                                FontSize="10"
                                                                Background="#2a2a35"
                                                                Foreground="#e4e4e7"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MoveModDownCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="4"
                                                            Content="🗑️"
                                                            Padding="6,2"
                                                            FontSize="11"
                                                            Background="#3f1d24"
                                                            Foreground="#fca5a5"
                                                            HorizontalAlignment="Center"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteModCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>


                    <TextBlock Grid.Row="3" Text="Telemetry Engine Log Streams:" FontSize="12" FontWeight="SemiBold" Foreground="#a1a1aa" Margin="0,12,0,4"/>
                    <ScrollViewer Grid.Row="4" Background="#09090b" Padding="10">
                        <TextBlock Text="{Binding TelemetryLogStreamText}" FontFamily="Courier New" FontSize="11" Foreground="#a1a1aa"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER SYSTEM STATUS LAYER SECTION -->
        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <Separator Background="#2a2a35" Height="1" Margin="0,0,0,10"/>
            <TextBlock Text="🛡️ Open Source CamelotHUB Project Layer" FontSize="11" Foreground="#52525b" HorizontalAlignment="Center"/>
        </StackPanel>
        
    </Grid>
</Window>
