        <!-- Layer 2: Ember Chalice (#E54E00) -->
        <Path Fill="#E54E00" Data="M162.986 18.519 C193.868 14.255 225.198 12.992 256.35 13.059 C288.565 13.129 320.706 14.623 352.624 19.189 C366.611 21.191 380.812 23.582 394.322 27.828 C397.32 28.77 400.242 29.99 403.196 31.063 C409.245 33.259 418.569 37.706 420.724 44.266 C422.587 49.935 419.003 60.385 417.6 66.222 C416.629 70.264 415.812 74.344 414.757 78.365 C417.1 78.74 419.352 79.11 421.477 80.237 C426.779 83.049 429.113 89.644 427.122 95.132 C424.982 95.171 422.989 95.017 421.022 95.97 C412.263 100.213 412.437 120.348 410.508 128.987 C407.901 140.663 404.688 152.275 398.889 162.845 C396.877 166.514 394.756 170.397 392.309 173.791 C390.215 176.693 387.539 179.436 385.764 182.541 C385.056 183.779 385.74 185.54 385.786 186.885 C385.881 189.66 384.879 193.235 383.126 195.412 C381.319 197.655 379.107 199.546 376.062 199.58 C375.222 199.589 374.113 199.273 373.383 199.816 C371.181 201.452 369.501 204.327 367.662 206.365 C365.276 209.007 362.458 211.347 359.862 213.779 C352.855 206.795 345.619 200.228 336.728 195.671 C328.3 191.352 319.201 188.541 309.84 187.172 C303.272 186.211 296.464 186.471 289.849 186.471 L261.861 186.471 L174.875 186.471 L174.875 223.483 C174.875 225.696 175.29 236.612 174.598 237.84 C174.18 238.582 173.143 239.074 172.402 239.432 C168.227 241.452 164.103 239.338 161.188 236.265 C157.1 231.956 157.857 225.585 159.253 220.417 C153.578 216.252 148.023 212.044 142.982 207.107 C140.677 204.849 138.843 201.918 136.354 199.869 C135.395 199.08 134.135 199.72 133.031 199.613 C130.393 199.358 128.186 197.703 126.527 195.76 C124.729 193.653 123.641 190.474 123.776 187.693 C123.841 186.333 124.642 184.219 123.95 182.97 C122.282 179.956 119.699 177.27 117.678 174.481 C115.463 171.424 113.563 167.968 111.695 164.688 C105.776 154.295 102.257 142.54 99.987 130.88 C99.181 126.743 98.61 122.609 98.072 118.431 C97.161 111.367 96.793 99.198 89.167 95.798 C87.191 94.918 85.021 95.266 82.949 95.451 C80.83 86.042 86.507 79.637 95.646 78.458 C94.164 73.039 93.067 